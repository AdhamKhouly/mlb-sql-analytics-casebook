*.zip
*.tar
*.tar.gz
*.7z
*.rar

# ignore generated result exports

*.csv~
*.xlsx~
*.xls~

# Keep project documentation and SQL files tracked

!README.md
!DATA_LICENSE.md
!LICENSE
!*.sql
!*.md
!assets/*.png
